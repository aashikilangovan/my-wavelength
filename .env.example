# Copy to .env.local for local dev. Never commit the real values.

# From your Spotify Developer Dashboard app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Minted once via `npm run auth`
SPOTIFY_REFRESH_TOKEN=

# Leave unset locally to use a local SQLite file (./local.db).
# Set both when pointing at a real Turso database (production / CI).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
